# URL of the deployed Google Apps Script Web App (ends in /exec).
# Without this set, the app falls back to in-memory demo data in dev only.
VITE_APPS_SCRIPT_URL=https://script.google.com/macros/s/XXXXXXXXXXXXXXXXXXXXXXXXXXXX/exec

# OAuth client ID from Google Cloud Console (Credentials > OAuth 2.0 Client IDs,
# type "Web application"), used by the admin app's Google Sign-In button.
# Must match the GOOGLE_CLIENT_ID script property set on the Apps Script project.
VITE_GOOGLE_CLIENT_ID=XXXXXXXXXXXX-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX.apps.googleusercontent.com

# Optional. Scopes the admin Google Sign-In account picker to this Workspace
# domain (UX only). Defaults to storalundby.se if unset. The actual
# enforcement is server-side - see Code.gs's adminEmailDomain Config value.
VITE_ADMIN_EMAIL_DOMAIN=storalundby.se
